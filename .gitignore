# Secrets: never commit API keys
.env
*.key

# Local data and generated output (your database, downloads, reports)
stockproof_data/
stockproof_report*.html
stockproof_earnings*.html
stockproof_research*.html
*.csv
*.db

# Probe results contain paths from your own computer
tools/*_result.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/

# macOS
.DS_Store

# Generated DSH config with paths from your own computer
stockproof.cordis.yml

# ...except the bundled demo data (`stockproof demo`)
!stockproof/demo_data/*.db
!stockproof/demo_data/**/*.csv

# Files from before the rename (marketmood → stockproof)
marketmood_data/
marketmood_report*.html
marketmood_earnings*.html
marketmood_research*.html
marketmood.cordis.yml
